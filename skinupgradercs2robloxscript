--- NAJSILNIEJSZY SYSTEM OBIJANIA REKURENCYJNEGO (REMOTE EVENTS) ---
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local _G = _G or {}
_G.AutoEarnActive = false

local function remoteEventBypassClick()
	while _G.AutoEarnActive do
		pcall(function()
			-- Skanowanie całej pamięci gry w poszukiwaniu sieciowych funkcji uderzeń/zarabiania
			for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
				if _G.AutoEarnActive == false then break end
				
				if remote:IsA("RemoteEvent") then
					local name = remote.Name:lower()
					-- Wykrywanie eventu powiązanego z klikaniem, botami, ekonomią lub minigrami
					if name:find("click") or name:find("hit") or name:find("earn") or name:find("money") or name:find("drill") or name:find("bot") or name:find("tap") then
						-- Wywołanie zdarzenia sieciowego bezpośrednio do serwera gry
						remote:FireServer()
						remote:FireServer(1)
						remote:FireServer(true)
					end
				end
			end
		end)
		task.wait(0.02) -- Ekstremalne tempo (50 wysłanych pakietów na sekundę)
	end
end

-- Obsługa suwaka
ToggleButton.MouseButton1Click:Connect(function()
	_G.AutoEarnActive = not _G.AutoEarnActive
	
	if _G.AutoEarnActive then
		ToggleIndicator:TweenPosition(UDim2.new(0, 32, 0, 2), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = ZlotoZolty
		task.spawn(remoteEventBypassClick)
	else
		ToggleIndicator:TweenPosition(UDim2.new(0, 3, 0, 2), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
	end
end)
