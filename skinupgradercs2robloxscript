--- BEZPIECZNE AUTOMATYCZNE KLIKANIE ---
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local _G = _G or {}
_G.AutoEarnActive = false

local function forceClick()
	while _G.AutoEarnActive do
		local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if PlayerGui then
			for _, guiObject in pairs(PlayerGui:GetDescendants()) do
				if _G.AutoEarnActive == false then break end
				
				if guiObject:IsA("ImageButton") or guiObject:IsA("TextButton") then
					if guiObject.Visible and (guiObject.Parent.Name:lower():find("bot") or guiObject.Name:lower():find("bot") or guiObject.Parent.Name:lower():find("drill")) then
						pcall(function()
							guiObject:Activate()
							for _, connection in pairs(getconnections(guiObject.MouseButton1Click)) do
								connection:Fire()
							end
							for _, connection in pairs(getconnections(guiObject.MouseButton1Down)) do
								connection:Fire()
							end
						end)
					end
				end
			end
		end
		task.wait(0.05) 
	end
end

-- Obsługa suwaka
ToggleButton.MouseButton1Click:Connect(function()
	_G.AutoEarnActive = not _G.AutoEarnActive
	
	if _G.AutoEarnActive then
		ToggleIndicator:TweenPosition(UDim2.new(0, 32, 0, 2), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = ZlotoZolty
		task.spawn(forceClick)
	else
		ToggleIndicator:TweenPosition(UDim2.new(0, 3, 0, 2), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
	end
end)
