--- LOGIKA AUTOMATYCZNEGO KLIKANIA BOTÓW ---

local _G = _G or {}
_G.AutoEarnActive = false

local function clickBots()
	while _G.AutoEarnActive do
		for _, v in pairs(workspace:GetDescendants()) do
			if _G.AutoEarnActive == false then break end
			
			if v:IsA("Humanoid") and v.Parent and v.Parent.Name ~= game:GetService("Players").LocalPlayer.Name then
				local part = v.Parent:FindFirstChild("HumanoidRootPart") or v.Parent:FindFirstChild("Head")
				if part then
					local clickDetector = v.Parent:FindFirstChildOfClass("ClickDetector")
					if clickDetector then
						fireclickdetector(clickDetector)
					else
						local tool = game:GetService("Players").LocalPlayer.Character:FindFirstChildOfClass("Tool")
						if tool then
							tool:Activate()
						end
					end
				end
			end
		end
		task.wait(0.1) 
	end
end

-- Obsługa suwaka (Włącznik / Wyłącznik)
ToggleButton.MouseButton1Click:Connect(function()
	_G.AutoEarnActive = not _G.AutoEarnActive
	
	if _G.AutoEarnActive then
		ToggleIndicator:TweenPosition(UDim2.new(0, 37, 0, 3), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = ZlotoZolty
		task.spawn(clickBots)
	else
		ToggleIndicator:TweenPosition(UDim2.new(0, 3, 0, 3), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
		ToggleIndicator.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
	end
end)
